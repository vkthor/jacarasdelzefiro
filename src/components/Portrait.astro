---
// Retrato circular con aro dorado, como en el dossier.
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata; alt: string; size?: number; eager?: boolean }
const { src, alt, size = 220, eager = false } = Astro.props;
---
<span class="ring" style={`--size:${size}px`}>
  <Image src={src} alt={alt} width={size * 2} height={size * 2} fit="cover" position="top" loading={eager ? 'eager' : 'lazy'} />
</span>

<style>
  .ring {
    display: inline-block;
    width: min(var(--size), 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: conic-gradient(from 210deg, #f6dc94, #b8822c, #f3d58a, #9c6b22, #e9c470, #f6dc94);
    box-shadow: 0 10px 24px -14px rgba(42, 31, 24, 0.7);
  }
  .ring :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%;
    border-radius: 50%; border: 3px solid var(--paper);
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s ease;
  }
  :global(a:hover) .ring :global(img), .ring:hover :global(img) { filter: grayscale(0); }
</style>
