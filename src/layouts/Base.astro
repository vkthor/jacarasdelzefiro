---
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/montserrat';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, tr, ui, type Lang, type RouteKey } from '../i18n';
import ogDefault from '../assets/fotos/playa-1.jpg';
import { getImage } from 'astro:assets';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description: string;
  image?: ImageMetadata;
}
const { lang, route, title, description, image } = Astro.props;
const siteName = tr(ui.siteName, lang);
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · ${tr(ui.tagline, lang)}`;
const og = await getImage({ src: image ?? ogDefault, width: 1200, format: 'jpg', quality: 80 });
const canonical = new URL(routes[route][lang], Astro.site);
const alternates = (['es', 'en'] as Lang[]).map((l) => ({ l, href: new URL(routes[route][l], Astro.site).href }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternates.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#6f2a31" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 800)} />
    <meta property="og:image:alt" content={lang === 'es' ? 'Jácaras del Zéfiro con sus instrumentos en la playa de Almuñécar' : 'Jácaras del Zéfiro with their instruments on the beach at Almuñécar'} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">{tr(ui.skip, lang)}</a>
    <Header lang={lang} route={route} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
