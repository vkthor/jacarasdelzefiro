---
// Programa de concierto: obras con autor, fuente y transcripción.
import type { Work } from '../data/programs';
import { tr, ui, type Lang } from '../i18n';
import { composerName, inline, names } from '../utils';

interface Props { works: Work[]; lang: Lang }
const { works, lang } = Astro.props;
const hasPremieres = works.some((w) => w.premiere);
---
<ol class="works">
  {works.map((w) => (
    <li class="work">
      <h3 class="work__title">
        {w.title}{w.voices && <span class="work__voices"> ({tr(w.voices, lang)})</span>}
        {w.premiere && <span class="star" title={tr(ui.premiere, lang)} aria-label={tr(ui.premiere, lang)}>✱</span>}
      </h3>
      <p class="work__composer">{composerName(w.composer, lang)}{w.dates && <span class="work__dates"> ({w.dates})</span>}</p>
      <p class="work__meta"><span set:html={inline(tr(w.genre, lang))} /> · <span set:html={inline(tr(w.source, lang))} /></p>
      <p class="work__transcr">{tr(ui.transcription, lang)} {names(w.transcription, lang)}</p>
    </li>
  ))}
</ol>
{hasPremieres && <p class="legend"><span class="star" aria-hidden="true">✱</span> {tr(ui.premiere, lang)}</p>}

<style>
  /* Repertorio: tinta más oscura, cuerpo y peso algo mayores para que se lea bien sobre el papel. */
  .works { list-style: none; margin: 0; padding: 0; counter-reset: work; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(24px, 4vw, 64px); }
  @media (max-width: 760px) { .works { grid-template-columns: 1fr; } }
  .work { counter-increment: work; position: relative; padding: 1.2rem 0 1.25rem 3.1rem; border-top: 1px solid var(--line); break-inside: avoid; }
  .work::before {
    content: counter(work, upper-roman); position: absolute; left: 0; top: 1.4rem; width: 2.4rem;
    font-family: var(--display); font-size: 0.92rem; font-weight: 600; color: var(--gold-ink); letter-spacing: 0.05em;
  }
  .work__title { font-family: var(--serif); font-size: 1.4rem; font-weight: 650; line-height: 1.2; color: var(--maroon); margin: 0 0 0.25rem; }
  .work__voices { font-weight: 500; color: #4e3f34; font-size: 0.86em; }
  .work__composer { margin: 0; font-size: 1.1rem; font-weight: 500; line-height: 1.4; color: var(--ink); }
  .work__dates { font-weight: 400; color: #4e3f34; }
  .work__meta { margin: 0.3rem 0 0; font-size: 1.02rem; font-weight: 450; line-height: 1.42; color: #3f3229; }
  .work__transcr { margin: 0.2rem 0 0; font-size: 1rem; font-weight: 450; line-height: 1.4; font-style: italic; color: #4e3f34; }
  .star { color: var(--coral); margin-left: 0.3em; font-size: 0.85em; font-style: normal; }
  .legend { font-family: var(--sans); font-size: 0.82rem; font-weight: 500; letter-spacing: 0.05em; color: #4e3f34; margin-top: 1.2rem; }
  @media (max-width: 520px) {
    .work { padding-left: 2.6rem; }
    .work::before { width: 2.2rem; font-size: 0.86rem; }
    .work__title { font-size: 1.32rem; }
  }
</style>
