---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
import { tr, url, type Lang } from '../i18n';
import azulejo from '../assets/graficos/ave-azulejo-rama.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  title: { es: 'Contacto', en: 'Contact' },
  lead: { es: 'Escríbenos para contratar un concierto, pedir material o simplemente saludarnos.', en: 'Write to us to book a concert, request materials or just say hello.' },
  description: { es: 'Contacto de Jácaras del Zéfiro para programadores, prensa y público.', en: 'Contact Jácaras del Zéfiro: for programmers, press and audiences.' },
  write: { es: 'Escríbenos', en: 'Write to us' },
  director: { es: 'Dirección artística', en: 'Artistic director' },
  follow: { es: 'Síguenos', en: 'Follow us' },
  materials: { es: 'Dossieres y fotos', en: 'Dossiers and photos' },
};
---
<Base lang={lang} route="contact" title={tr(t.title, lang)} description={tr(t.description, lang)}>
  <PageHead kicker="Jácaras del Zéfiro" title={tr(t.title, lang)} lead={tr(t.lead, lang)} bird={azulejo} />
  <section class="section">
    <div class="wrap contact-grid">
      <div>
        <p class="kicker">{tr(t.write, lang)}</p>
        <p class="big-mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="kicker" style="margin-top:2rem">{tr(t.director, lang)}</p>
        <p>Víctor Cruz · <a href={site.directorSite} rel="noopener">victorcruz.es</a></p>
      </div>
      <div>
        <p class="kicker">{tr(t.follow, lang)}</p>
        <p><a href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a><br /><a href={site.youtube} rel="noopener">YouTube</a></p>
        <p class="kicker" style="margin-top:2rem">{tr(t.materials, lang)}</p>
        <p>{lang === 'es' ? 'Dossieres y fotos en alta resolución, en la página de' : 'Dossiers and high-resolution photos on the'} <a href={`${url('press', lang)}#kit`}>{lang === 'es' ? 'prensa' : 'press page'}</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
  .big-mail { font-family: var(--serif); font-weight: 600; font-size: clamp(1.35rem, 1.6vw + 0.9rem, 2rem); overflow-wrap: anywhere; }
  .big-mail a { text-decoration: none; }
  .contact-grid p a { display: inline-block; padding: 0.3rem 0; }
</style>
