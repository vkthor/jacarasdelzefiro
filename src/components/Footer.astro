---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';
import { site } from '../data/site';
import { nav, tr, ui, url, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const es = lang === 'es';
---
<footer class="site-footer night">
  <div class="torn torn--footer" aria-hidden="true"></div>
  <div class="wrap">
    <!-- Marca: logotipo y lema, centrados -->
    <div class="f-brand">
      <a href={url('home', lang)} aria-label={tr(ui.siteName, lang)}>
        <Image src={logo} alt="" width={180} height={180} class="f-logo" />
      </a>
      <p class="f-tagline">{tr(ui.tagline, lang)}</p>
      <p class="f-motto">{tr(ui.motto, lang)}</p>
    </div>

    <div class="f-ornament" aria-hidden="true"><span></span><i>✦</i><span></span></div>

    <!-- Tres columnas: contacto, secciones, redes -->
    <div class="f-cols">
      <div class="f-col">
        <p class="f-head">{tr(ui.nav.contact, lang)}</p>
        <a class="f-link f-mail" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v11H3z M3.5 7l8.5 6.5L20.5 7" /></svg>
          {site.email}
        </a>
        <p class="f-note">{es ? 'Para festivales, ciclos y programadores' : 'For festivals, series and promoters'}</p>
      </div>

      <nav class="f-col" aria-label={es ? 'Secciones' : 'Sections'}>
        <p class="f-head">{es ? 'Secciones' : 'Sections'}</p>
        <ul class="f-nav">
          {nav.filter((key) => key !== 'home').map((key) => <li><a href={url(key, lang)}>{tr(ui.nav[key], lang)}</a></li>)}
        </ul>
      </nav>

      <div class="f-col">
        <p class="f-head">{es ? 'Síguenos' : 'Follow us'}</p>
        <a class="f-link" href={site.instagram} rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" class="dot" /></svg>
          Instagram <span class="f-handle">{site.instagramHandle}</span>
        </a>
        <a class="f-link" href={site.youtube} rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="M10 9.2v5.6l4.8-2.8z" class="dot" /></svg>
          YouTube
        </a>
        <p class="f-note">{es ? 'Dirección artística' : 'Artistic director'}: <a href={`${site.directorSite}/${es ? '' : 'en/'}`} rel="noopener">Víctor Cruz</a></p>
      </div>
    </div>

    <div class="f-bottom">
      <span>© {year} Jácaras del Zéfiro</span>
      <span class="f-legal"><a href={url('legal', lang)}>{tr(ui.nav.legal, lang)}</a><span aria-hidden="true">·</span><a href={url('privacy', lang)}>{tr(ui.nav.privacy, lang)}</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; padding: clamp(72px, 9vw, 108px) 0 22px; margin-top: 0; }
  .torn--footer { position: absolute; top: 0; left: 0; right: 0; margin: 0; transform: translateY(-55.5%) scaleY(-1); }
  .site-footer a { text-decoration: none; }

  .f-brand { text-align: center; }
  .f-brand > a { display: inline-block; }
  .f-logo { display: block; margin: 0 auto; width: 116px; height: auto; filter: brightness(0) invert(0.92) sepia(0.25); opacity: 0.95; }
  .f-tagline { margin: 0.9rem 0 0; font-family: var(--display); font-size: 0.82rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
  .f-motto { margin: 0.35rem 0 0; font-style: italic; font-size: 1.2rem; color: #d9cbb6; }

  .f-ornament { display: flex; align-items: center; justify-content: center; gap: 0.9rem; margin: 2.2rem auto 2.6rem; max-width: 420px; color: var(--gold); }
  .f-ornament span { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(201, 155, 71, 0.65)); }
  .f-ornament span:last-child { background: linear-gradient(90deg, rgba(201, 155, 71, 0.65), transparent); }
  .f-ornament i { font-style: normal; font-size: 0.8rem; }

  .f-cols { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
  .f-col { padding: 0 clamp(16px, 3vw, 40px); display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .f-col + .f-col { border-left: 1px solid rgba(201, 155, 71, 0.22); }
  .f-head { margin: 0 0 0.8rem; font-family: var(--sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); }

  .f-link { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.3rem 0; color: #f0dcc4; transition: color 0.2s ease; }
  .f-link:hover { color: #fff; }
  .f-link svg { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--gold); stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; }
  .f-link svg .dot { fill: var(--gold); stroke: none; }
  .f-mail { overflow-wrap: anywhere; }
  .f-handle { color: #b9aa95; font-size: 0.92em; }
  .f-note { margin: 0.6rem 0 0; font-size: 1rem; font-style: italic; color: #b9aa95; }
  .f-note a { color: #f0c9a6; }
  .f-note a:hover { color: #fff; }

  .f-nav { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, auto); justify-content: center; column-gap: 2rem; }
  .f-nav a { display: inline-block; padding: 0.28rem 0; color: #efe5d6; }
  .f-nav a:hover { color: #fff; text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }

  .f-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.4rem 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.1); font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.08em; color: #9d8f7c; }
  .f-legal { display: inline-flex; align-items: center; gap: 0.5rem; }
  .f-bottom a { display: inline-block; padding: 0.5rem 0.1rem; color: #b9aa95; }
  .f-bottom a:hover { color: #fff; }

  @media (max-width: 820px) {
    .f-cols { grid-template-columns: 1fr; gap: 2rem; }
    .f-col + .f-col { border-left: 0; border-top: 1px solid rgba(201, 155, 71, 0.22); padding-top: 2rem; }
    .f-bottom { justify-content: center; text-align: center; }
  }
</style>
