---
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/montserrat';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, tr, ui, type Lang, type RouteKey } from '../i18n';
import ogDefault from '../assets/fotos/playa-1.jpg';
import fotoAvecillas from '../assets/fotos/fias-percusion.jpg';
import fotoNavidad from '../assets/fotos/almunecar-gamba.jpg';
import fotoDuo from '../assets/fotos/duo-del-zefiro.jpg';
import logoImg from '../assets/logo/logo.png';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { musicians } from '../data/musicians';
import { concerts } from '../data/concerts';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean; // páginas que no deben salir en buscadores (aviso legal, privacidad, 404)
}
const { lang, route, title, description, image, noindex = false } = Astro.props;
const siteName = tr(ui.siteName, lang);
// Portada: nombre + lo que somos, con las palabras que se buscan («música antigua», «barroco»).
const homeTitle = lang === 'es' ? 'Música antigua y barroco hispano' : 'Spanish early music and Baroque';
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · ${homeTitle}`;
const og = await getImage({ src: image ?? ogDefault, width: 1200, format: 'jpg', quality: 80 });
const canonical = new URL(routes[route][lang], Astro.site);
const alternates = (['es', 'en'] as Lang[]).map((l) => ({ l, href: new URL(routes[route][l], Astro.site).href }));

// Datos estructurados (schema.org): el grupo, la web y la página, para buscadores y asistentes de IA.
const home = new URL('/', Astro.site).href;
const logo = await getImage({ src: logoImg, width: 512, format: 'png' });
const groupDesc = {
  es: 'Conjunto español de música antigua fundado y dirigido por el barítono Víctor Cruz. Recupera el repertorio barroco hispano —tonos, villancicos, jácaras y ensaladas— con voces, cuerda pulsada, viola da gamba y percusión.',
  en: 'Spanish early-music ensemble founded and directed by baritone Víctor Cruz. It revives the Spanish Baroque repertoire —tonos, villancicos, jácaras and ensaladas— with voices, plucked strings, viola da gamba and percussion.',
};
const directorId = `${site.directorSite}/#person`;
const group = {
  '@type': 'MusicGroup',
  '@id': `${home}#group`,
  name: site.name,
  url: home,
  logo: new URL(logo.src, Astro.site).href,
  image: new URL(og.src, Astro.site).href,
  description: groupDesc[lang],
  email: `mailto:${site.email}`,
  foundingDate: '2025',
  foundingLocation: { '@type': 'Place', name: 'España' },
  genre: lang === 'es' ? ['Música antigua', 'Música barroca', 'Música del Renacimiento'] : ['Early music', 'Baroque music', 'Renaissance music'],
  founder: { '@type': 'Person', '@id': directorId, name: site.director, url: `${site.directorSite}/`, sameAs: ['https://www.wikidata.org/wiki/Q130535337'] },
  member: musicians.map((m) => ({
    '@type': 'OrganizationRole',
    roleName: m.role[lang],
    member: m.id === 'victor-cruz'
      ? { '@type': 'Person', '@id': directorId, name: m.name, url: `${site.directorSite}/` }
      : { '@type': 'Person', name: m.name, ...('web' in m && m.web ? { url: m.web[lang] } : {}) },
  })),
  sameAs: [site.instagram, 'https://www.wikidata.org/wiki/Q142294615'],
};
// Conciertos para Google («eventos»): no se ven en la página. Todos han sido de entrada gratuita.
const tz = (d: string) => (+d.slice(5, 7) >= 4 && +d.slice(5, 7) <= 10 ? '+02:00' : '+01:00'); // hora peninsular
const eventArt = {
  avecillas: { route: 'avecillas', img: await getImage({ src: fotoAvecillas, width: 1200, format: 'jpg', quality: 80 }) },
  navidad: { route: 'navidad', img: await getImage({ src: fotoNavidad, width: 1200, format: 'jpg', quality: 80 }) },
  duo: { route: 'duo', img: await getImage({ src: fotoDuo, width: 1200, format: 'jpg', quality: 80 }) },
} as const;
const events = concerts.map((c) => {
  const art = eventArt[c.ensemble === 'duo' ? 'duo' : c.program.es === 'Avecillas' ? 'avecillas' : 'navidad'];
  const page = new URL(routes[art.route][lang], Astro.site).href;
  const who = c.ensemble === 'duo' ? 'Dúo del Zéfiro' : site.name;
  // Fin: el día indicado o, en conciertos de un día, hora y media después del comienzo.
  let endDate = c.endDate ?? c.date;
  if (!c.endDate && c.time) {
    const [h, m] = c.time.split(':').map(Number);
    const t = h * 60 + m + 90;
    endDate = `${c.date}T${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}:00${tz(c.date)}`;
  }
  return {
    '@type': 'MusicEvent',
    name: `${who}: ${c.program[lang]}`,
    description: lang === 'es'
      ? `${who}: «${c.program.es}». ${c.series.es}. ${c.venue}, ${c.city}. Entrada gratuita.`
      : `${who}: “${c.program.en}”. ${c.series.en}. ${c.venue}, ${c.city}. Free admission.`,
    image: [new URL(art.img.src, Astro.site).href],
    startDate: c.time ? `${c.date}T${c.time}:00${tz(c.date)}` : c.date,
    endDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: { '@type': 'Place', name: c.venue, address: { '@type': 'PostalAddress', addressLocality: c.city, addressCountry: 'ES' } },
    performer: c.ensemble === 'duo' ? { '@type': 'MusicGroup', name: 'Dúo del Zéfiro', url: new URL(routes.duo[lang], Astro.site).href } : { '@id': `${home}#group` },
    organizer: { '@type': 'Organization', name: c.series[lang], ...(c.url ? { url: c.url } : {}) },
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: c.url ?? page },
    url: c.url ?? page,
  };
});
const jsonld = noindex ? null : {
  '@context': 'https://schema.org',
  '@graph': [
    route === 'home' || route === 'ensemble' ? { ...group, event: events } : group,
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.name, inLanguage: ['es', 'en'], publisher: { '@id': `${home}#group` } },
    {
      '@type': route === 'ensemble' ? 'AboutPage' : route === 'contact' ? 'ContactPage' : 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: fullTitle,
      description,
      inLanguage: lang,
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': `${home}#group` },
      primaryImageOfPage: new URL(og.src, Astro.site).href,
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {route === 'home' && lang === 'es' && <meta name="msvalidate.01" content="615E3B47AFB25F5FAB8B0CEA204CDDC4" />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    {alternates.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#6f2a31" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 800)} />
    <meta property="og:image:alt" content={lang === 'es' ? 'Jácaras del Zéfiro con sus instrumentos en la playa de Almuñécar' : 'Jácaras del Zéfiro with their instruments on the beach at Almuñécar'} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_GB' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">{tr(ui.skip, lang)}</a>
    <Header lang={lang} route={route} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
    {site.cloudflareToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${site.cloudflareToken}"}`}></script>
    )}
  </body>
</html>
