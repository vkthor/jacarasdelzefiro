---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Dropcap from '../components/Dropcap.astro';
import Portrait from '../components/Portrait.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { musicians } from '../data/musicians';
import { programs } from '../data/programs';
import { q, reviews } from '../data/press';
import { videos } from '../data/site';
import { tr, ui, url, type Lang } from '../i18n';
import { inline } from '../utils';

import playa from '../assets/fotos/playa-1.jpg';
import poster from '../assets/fotos/video-batalla.jpg';
import duoFoto from '../assets/fotos/duo-del-zefiro.jpg';
import gato from '../assets/logo/gato.png';
import golondrina1 from '../assets/graficos/ave-golondrina-1.webp';
import golondrina2 from '../assets/graficos/ave-golondrina-2.webp';
import azulejo from '../assets/graficos/ave-azulejo-rama.webp';
import parejaBaile from '../assets/graficos/pareja-baile.webp';
import parejaPandero from '../assets/graficos/pareja-pandero.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;

const t = {
  description: {
    es: 'Jácaras del Zéfiro es un ensemble de música antigua fundado por el barítono Víctor Cruz: barroco hispano, recuperación de patrimonio y seis músicos que cantan y tocan a la vez.',
    en: 'Jácaras del Zéfiro is an early music ensemble founded by baritone Víctor Cruz: Hispanic Baroque, rediscovered heritage and six musicians who sing and play at the same time.',
  },
  heroKicker: { es: 'Música antigua hispana', en: 'Early music from Spain' },
  introKicker: { es: 'El grupo', en: 'The ensemble' },
  introTitle: { es: 'Investigación e instinto', en: 'Research and instinct' },
  intro1: {
    es: 'Fundado por el barítono [Víctor Cruz](https://www.victorcruz.es/), Jácaras del Zéfiro propone una visión de la música historicista donde conviven la investigación y el instinto. El objetivo es ir más allá de la mera reconstrucción arqueológica para recuperar el pulso real de las obras: su ímpetu, su danza y su capacidad de conmover.',
    en: 'Founded by baritone [Víctor Cruz](https://www.victorcruz.es/en/), Jácaras del Zéfiro offers a vision of historically informed performance in which research and instinct go hand in hand. The aim is to go beyond mere archaeological reconstruction and recover the true pulse of the works: their drive, their dance and their power to move.',
  },
  intro2: {
    es: 'El ensemble combina voces, cuerda pulsada, viola da gamba y percusión. Sus intérpretes, de sólida carrera, entienden la música antigua no como piezas de museo, sino como un lenguaje vibrante que requiere conocimiento, pero también viveza y carácter. Y en el escenario, quien canta también toca.',
    en: 'The ensemble combines voices, plucked strings, viola da gamba and percussion. Its performers, all with solid careers, see early music not as museum pieces but as a vibrant language that demands knowledge, but also liveliness and character. And on stage, those who sing also play.',
  },
  programsKicker: { es: 'Programas', en: 'Programmes' },
  programsTitle: { es: 'Del archivo al escenario', en: 'From the archive to the stage' },
  programsIntro: {
    es: 'Repertorio hispano del Renacimiento y el Barroco, con obras que llevaban siglos sin sonar, transcritas de los manuscritos de catedrales de España y América.',
    en: 'Hispanic repertoire from the Renaissance and Baroque, with works unheard for centuries, transcribed from the manuscripts of cathedrals in Spain and the Americas.',
  },
  avecillasStats: { es: '12 obras · 6 estrenos en tiempos modernos · 70 min', en: '12 works · 6 modern-day premieres · 70 min' },
  navidadSubtitle: { es: 'Villancicos al Nacimiento', en: 'Villancicos for the Nativity' },
  navidadStats: { es: '11 obras · Renacimiento y Barroco · 70 min', en: '11 works · Renaissance and Baroque · 70 min' },
  duoKicker: { es: 'También', en: 'Also' },
  duoText: {
    es: 'Purcell, Eccles y Courteville para la trilogía londinense de Thomas D’Urfey: una ópera de cámara para voz, cuerda pulsada y escena.',
    en: 'Purcell, Eccles and Courteville for Thomas D’Urfey’s London trilogy: a chamber opera for voice, plucked strings and stage.',
  },
  duoLink: { es: 'Conoce al Dúo del Zéfiro', en: 'Meet the Dúo del Zéfiro' },
  videoKicker: { es: 'Así sonamos', en: 'How we sound' },
  pressKicker: { es: 'Prensa', en: 'Press' },
  musiciansKicker: { es: 'Los músicos', en: 'The musicians' },
  ctaTitle: { es: '¿Programas un festival o un ciclo?', en: 'Do you programme a festival or a concert series?' },
  ctaText: {
    es: 'Llevamos nuestros propios instrumentos y nos adaptamos a iglesias, auditorios y salas de cámara: lo esencial es una buena acústica. Escríbenos y te enviamos el dossier, la ficha técnica y las condiciones.',
    en: 'We bring our own instruments and adapt to churches, concert halls and chamber venues: what matters most is good acoustics. Write to us and we will send you the dossier, technical rider and terms.',
  },
};
const avec = programs.avecillas;
const nav = programs.navidad;
---
<Base lang={lang} route="home" description={tr(t.description, lang)}>
  <!-- Portada -->
  <section class="hero">
    <div class="hero__content wrap">
      <p class="kicker hero__kicker">{tr(t.heroKicker, lang)}</p>
      <h1 class="hero__title">Jácaras <span>del</span> Zéfiro</h1>
      <p class="hero__tagline">{lang === 'es' ? 'Barroco con acento hispano auténtico.' : 'Baroque with an authentic Spanish accent.'}<br /><em>{tr(ui.motto, lang)}</em></p>
    </div>
    <Image src={playa} alt={lang === 'es' ? 'Jácaras del Zéfiro en la playa de Almuñécar, con sus instrumentos' : 'Jácaras del Zéfiro on the beach at Almuñécar, with their instruments'} widths={[800, 1400, 2000, 2800]} sizes="100vw" format="webp" quality={78} loading="eager" fetchpriority="high" class="hero__img" />
    <Image src={golondrina2} alt="" class="bird hero__swallow1" width={150} loading="eager" />
    <Image src={golondrina1} alt="" class="bird hero__swallow2 bird--hide-sm" width={110} loading="eager" />
  </section>
  <div class="torn" aria-hidden="true"></div>

  <!-- Presentación -->
  <section class="section intro">
    <div class="wrap intro__grid">
      <div class="prose">
        <p class="kicker">{tr(t.introKicker, lang)}</p>
        <h2 class="title-section">{tr(t.introTitle, lang)}</h2>
        <Dropcap text={tr(t.intro1, lang)} />
        <p>{tr(t.intro2, lang)}</p>
        <p><a class="btn" href={url('ensemble', lang)}>{tr(ui.meetEnsemble, lang)}</a></p>
      </div>
      <div class="intro__seal">
        <Image src={gato} alt="" width={340} class="intro__cat" />
      </div>
    </div>
  </section>

  <!-- Programas -->
  <section class="section linen programs" id="programas">
    <div class="wrap">
      <div class="center narrow programs__head">
        <p class="kicker">{tr(t.programsKicker, lang)}</p>
        <h2 class="title-section">{tr(t.programsTitle, lang)}</h2>
        <p>{tr(t.programsIntro, lang)}</p>
      </div>
      <div class="grid-2 cards">
        <article class="card">
          <Image src={azulejo} alt="" width={200} class="card__art card__art--bird" />
          <h3 class="title-program card__title">{avec.title}</h3>
          <p class="subtitle-spaced">{tr(avec.subtitle, lang)}</p>
          <p class="card__lead">{tr(avec.lead, lang)}</p>
          <p class="card__stats">{tr(t.avecillasStats, lang)}</p>
          <div class="btn-row">
            <a class="btn btn--solid" href={url('avecillas', lang)}>{tr(ui.seeProgram, lang)}</a>
            <a class="btn" href={url('bookletAvecillas', lang)}>{tr(ui.booklet, lang)}</a>
          </div>
        </article>
        <article class="card">
          <Image src={parejaPandero} alt="" width={150} class="card__art card__art--figure" />
          <h3 class="title-program card__title">{nav.title}</h3>
          <p class="subtitle-spaced">{tr(t.navidadSubtitle, lang)}</p>
          <p class="card__lead">{tr(nav.lead, lang)}</p>
          <p class="card__stats">{tr(t.navidadStats, lang)}</p>
          <div class="btn-row">
            <a class="btn btn--solid" href={url('navidad', lang)}>{tr(ui.seeProgram, lang)}</a>
            <a class="btn" href={url('bookletNavidad', lang)}>{tr(ui.booklet, lang)}</a>
          </div>
        </article>
      </div>
      <a class="duo-teaser" href={url('duo', lang)}>
        <Image src={duoFoto} alt="" width={240} height={240} fit="cover" class="duo-teaser__img" />
        <span>
          <span class="kicker">{tr(t.duoKicker, lang)}</span>
          <strong class="duo-teaser__title">Dúo del Zéfiro · <em>{lang === 'es' ? 'La Cómica Historia de Don Quijote' : 'The Comical History of Don Quixote'}</em></strong>
          <span class="duo-teaser__text">{tr(t.duoText, lang)}</span>
          <span class="duo-teaser__link">{tr(t.duoLink, lang)} →</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Vídeo -->
  <section class="section night video-band">
    <div class="wrap narrow-video">
      <p class="kicker center">{tr(t.videoKicker, lang)}</p>
      <h2 class="title-section center">{tr(videos.batalla.title, lang)}</h2>
      <VideoEmbed id={videos.batalla.id} title={tr(videos.batalla.title, lang)} poster={poster} lang={lang} />
      <p class="caption center">{tr(videos.batalla.caption, lang)}</p>
    </div>
  </section>

  <!-- Prensa -->
  <section class="section linen-light press">
    <div class="wrap">
      <p class="kicker center">{tr(t.pressKicker, lang)}</p>
      <div class="grid-2 quotes">
        {reviews.map((r) => (
          <figure class="quote">
            <blockquote>
              <p class="quote__head">{q(tr(r.headline, lang), lang)}</p>
              <p class="quote__body">{q(tr(r.quote, lang), lang)}</p>
            </blockquote>
            <figcaption><strong>{r.outlet}</strong> · {r.author} · <span set:html={inline(tr(r.context, lang))} /> <a class="tap" href={r.url} rel="noopener">{tr(ui.readReview, lang)}</a></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Músicos -->
  <section class="section musicians">
    <div class="wrap center">
      <p class="kicker">{tr(t.musiciansKicker, lang)}</p>
      <ul class="people">
        {musicians.map((m) => (
          <li>
            <a href={`${url('ensemble', lang)}#${m.id}`}>
              <Portrait src={m.photo} alt={m.name} size={150} />
              <span class="people__role">{tr(m.role, lang)}</span>
              <span class="people__name">{m.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <span class="ornament" aria-hidden="true"></span>
    </div>
  </section>

  <!-- Programadores -->
  <section class="section linen cta">
    <Image src={parejaBaile} alt="" width={190} class="bird cta__figure bird--hide-sm" />
    <div class="wrap narrow center">
      <p class="kicker">{tr(ui.forProgrammers, lang)}</p>
      <h2 class="title-section">{tr(t.ctaTitle, lang)}</h2>
      <p>{tr(t.ctaText, lang)}</p>
      <div class="btn-row cta__btns">
        <a class="btn btn--solid" href={url('contact', lang)}>{tr(ui.writeUs, lang)}</a>
        <a class="btn" href={url('programs', lang)}>{tr(ui.allPrograms, lang)}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Portada */
  /* El cielo de la foto se prolonga hacia arriba con un degradado de su mismo color. */
  .hero { position: relative; overflow: hidden; background: linear-gradient(to bottom, #86bbf4 0%, #99c7fd 100%); }
  /* La foto se muestra entera (sin recortar el cielo) y el título queda en el cielo prolongado de encima. */
  .hero :global(.hero__img) {
    position: relative; z-index: 0; display: block; width: 100%; height: auto; aspect-ratio: 3 / 2;
    object-fit: cover; margin-top: -3vw;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12%); mask-image: linear-gradient(to bottom, transparent 0, #000 12%);
  }
  .hero__content { position: relative; z-index: 2; padding-top: clamp(28px, 4vw, 64px); padding-bottom: clamp(8px, 1.5vw, 24px); text-align: center; }
  .hero__kicker { color: var(--maroon-deep); margin-bottom: 0.6rem; }
  .hero__title {
    font-family: var(--display); font-weight: 600; color: var(--maroon);
    font-size: clamp(2.4rem, 6.4vw, 6rem); letter-spacing: 0.03em; line-height: 1; margin: 0;
    text-shadow: 0 2px 18px rgba(255, 255, 255, 0.55);
  }
  .hero__title span { font-size: 0.72em; }
  .hero__tagline { margin: 0.8rem auto 0; font-size: clamp(1.1rem, 1vw + 0.85rem, 1.55rem); color: var(--maroon-deep); text-shadow: 0 1px 10px rgba(255, 255, 255, 0.7); max-width: 36ch; }
  .hero :global(.hero__swallow1) { top: clamp(16px, 3vw, 48px); left: 7%; width: clamp(64px, 8vw, 140px); transform: rotate(-8deg); z-index: 2; }
  .hero :global(.hero__swallow2) { top: clamp(90px, 11vw, 170px); right: 8%; width: clamp(54px, 6vw, 104px); transform: scaleX(-1) rotate(-10deg); z-index: 2; }
  @media (max-width: 760px) {
    .hero :global(.hero__img) { margin-top: -6vw; }
    /* En móvil, pequeña y en el hueco de arriba a la izquierda, sin tocar el título. */
    .hero :global(.hero__swallow1) { top: 4px; left: 2%; width: clamp(34px, 10vw, 52px); }
    .hero__content { padding-top: 34px; }
  }

  /* Presentación */
  .intro__grid { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .intro__seal { position: relative; display: grid; place-items: center; }
  .intro__seal :global(.intro__cat) { width: min(320px, 80%); filter: drop-shadow(0 18px 24px rgba(60, 35, 20, 0.18)); }
  .intro__seal :global(.intro__bird) { right: 0; top: -6%; width: clamp(100px, 12vw, 170px); }
  @media (max-width: 860px) { .intro__grid { grid-template-columns: 1fr; } .intro__seal { order: -1; } .intro__seal :global(.intro__cat) { width: 130px; } .intro { padding-top: 32px; } }

  /* Programas */
  .programs__head { margin-inline: auto; margin-bottom: clamp(32px, 5vw, 56px); }
  .card {
    position: relative; background: var(--paper); padding: clamp(28px, 4vw, 48px); padding-top: clamp(40px, 5vw, 64px);
    box-shadow: 0 1px 0 var(--line), 0 24px 40px -30px rgba(60, 35, 20, 0.55); border-radius: 2px;
    display: flex; flex-direction: column;
  }
  .card__title { font-size: clamp(2.3rem, 3.6vw + 1rem, 3.8rem); max-width: 80%; }
  .card .subtitle-spaced { max-width: 80%; }
  .card__lead { font-style: italic; color: var(--ink-soft); margin-top: 1.2rem; font-size: 1.15rem; }
  .card__stats { font-family: var(--sans); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-ink); margin: 0.2rem 0 1.6rem; }
  .card .btn-row { margin-top: auto; }
  .card :global(.card__art) { position: absolute; pointer-events: none; }
  .card :global(.card__art--bird) { right: -18px; top: -38px; width: clamp(110px, 13vw, 190px); }
  @media (max-width: 760px) { .card :global(.card__art--bird) { right: 0; top: -72px; width: 90px; } .card .subtitle-spaced { max-width: none; } }
  .card :global(.card__art--figure) { right: 8px; top: -30px; width: clamp(80px, 9vw, 130px); }
  .duo-teaser {
    display: grid; grid-template-columns: 120px 1fr; gap: 1.5rem; align-items: center; margin: clamp(32px, 4vw, 48px) auto 0; max-width: 820px;
    text-decoration: none; color: var(--ink); background: rgba(244, 236, 223, 0.75); padding: 1.1rem 1.4rem; border: 1px solid var(--line); border-radius: 2px;
  }
  .duo-teaser :global(.duo-teaser__img) { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; }
  .duo-teaser > span { display: flex; flex-direction: column; gap: 0.2rem; }
  .duo-teaser .kicker { margin: 0; }
  .duo-teaser__title { font-family: var(--serif); font-size: 1.3rem; color: var(--maroon); font-weight: 600; }
  .duo-teaser__text { color: var(--ink-soft); }
  .duo-teaser__link { font-family: var(--sans); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--maroon); margin-top: 0.3rem; }
  .duo-teaser:hover .duo-teaser__link { color: var(--coral); }
  @media (max-width: 560px) { .duo-teaser { grid-template-columns: 1fr; text-align: center; } .duo-teaser :global(.duo-teaser__img) { margin-inline: auto; } }

  /* Vídeo */
  .narrow-video { max-width: 980px; }
  .video-band .title-section { margin-bottom: 1.6rem; }
  .video-band .caption { color: #cdbfa9; max-width: 70ch; margin-inline: auto; margin-top: 1rem; }

  /* Prensa */
  .quote { text-align: center; padding: 0 clamp(0px, 2vw, 24px); }
  .quote blockquote { margin: 0; }
  .quote__head { font-family: var(--display); color: var(--maroon); font-size: clamp(1.45rem, 1.4vw + 1rem, 2.1rem); line-height: 1.25; margin-bottom: 0.6rem; }
  .quote__body { font-style: italic; font-size: 1.2rem; color: var(--ink-soft); }
  .quote figcaption { font-size: 0.78rem; }
  .quote figcaption :global(em) { font-style: italic; }

  /* Músicos */
  .people { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(16px, 2.5vw, 32px); }
  .people a { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; text-decoration: none; color: var(--ink); }
  .people__role { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--ink-soft); margin-top: 0.6rem; text-align: center; line-height: 1.3; min-height: 2.6em; display: flex; align-items: flex-start; justify-content: center; }
  .people__name { font-family: var(--serif); font-weight: 600; font-size: 1.12rem; color: var(--maroon); text-align: center; line-height: 1.2; }
  @media (max-width: 980px) { .people { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2rem; } }
  @media (max-width: 520px) { .people { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Programadores */
  .cta { overflow: hidden; }
  .cta__btns { justify-content: center; margin-top: 1.6rem; }
  .cta :global(.cta__figure) { left: max(2vw, calc(50% - 620px)); bottom: 0; width: clamp(110px, 12vw, 190px); }
</style>
