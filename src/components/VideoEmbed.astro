---
// Vídeo de YouTube con «fachada»: no se carga nada de YouTube (ni cookies) hasta que se pulsa.
import { Image } from 'astro:assets';
import { tr, ui, type Lang } from '../i18n';

interface Props { id: string; title: string; poster: ImageMetadata; lang: Lang; vertical?: boolean }
const { id, title, poster, lang, vertical = false } = Astro.props;
---
<div class:list={['video', { 'video--vertical': vertical }]} data-video={id}>
  <button type="button" class="video__btn" aria-label={`${tr(ui.play, lang)}: ${title}`}>
    <Image src={poster} alt="" widths={[640, 1100, 1600]} sizes="(max-width: 980px) 100vw, 980px" format="webp" quality={76} class="video__poster" />
    <span class="video__play" aria-hidden="true"></span>
  </button>
  <p class="video__consent">{tr(ui.videoConsent, lang)}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    const btn = box.querySelector('button');
    btn?.addEventListener('click', () => {
      const id = box.dataset.video;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label') ?? 'YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'video__frame';
      btn.replaceWith(iframe);
      box.querySelector('.video__consent')?.remove();
    });
  });
</script>

<style>
  .video { position: relative; }
  .video__btn, :global(.video__frame) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0; background: #000; cursor: pointer; position: relative; overflow: hidden; border-radius: var(--radius); }
  .video--vertical .video__btn, .video--vertical :global(.video__frame) { aspect-ratio: 9 / 16; max-width: 380px; margin-inline: auto; }
  .video__btn :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease, opacity 0.3s; opacity: 0.88; }
  .video__btn:hover :global(img) { transform: scale(1.03); opacity: 1; }
  .video__play {
    position: absolute; inset: 0; margin: auto; width: 84px; height: 84px; border-radius: 50%;
    background: rgba(111, 42, 49, 0.88); box-shadow: 0 0 0 6px rgba(244, 236, 223, 0.35); transition: transform 0.2s, background 0.2s;
  }
  .video__play::after { content: ''; position: absolute; left: 34px; top: 26px; border-style: solid; border-width: 16px 0 16px 26px; border-color: transparent transparent transparent #f4ecdf; }
  .video__btn:hover .video__play { transform: scale(1.07); background: var(--coral); }
  .video__consent { font-family: var(--sans); font-size: 0.7rem; letter-spacing: 0.03em; opacity: 0.7; margin: 0.6rem 0 0; }
</style>
